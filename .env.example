# Ping Messaging Backend Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server host to bind to (0.0.0.0 for all interfaces)
SERVER_HOST=0.0.0.0

# Server port to listen on
SERVER_PORT=8080

# Environment mode: development, staging, production
ENVIRONMENT=development

# HTTP server read timeout in seconds
SERVER_READ_TIMEOUT=15

# HTTP server write timeout in seconds
SERVER_WRITE_TIMEOUT=15

# Maximum header bytes for HTTP requests
SERVER_MAX_HEADER_BYTES=1048576

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================

# PostgreSQL Data Source Name (DSN)
# Format: postgresql://username:password@host:port/database?sslmode=mode
# For local development without SSL:
DATABASE_DSN=postgresql://postgres:postgres@localhost:5432/ping?sslmode=disable

# Maximum database connections in pool
DATABASE_MAX_CONNS=10

# Minimum idle database connections in pool
DATABASE_MIN_CONNS=2

# Maximum connection lifetime in minutes
DATABASE_MAX_CONN_LIFETIME=30

# Maximum connection idle time in minutes
DATABASE_MAX_CONN_IDLE_TIME=5

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis server address (host:port)
REDIS_ADDRESS=localhost:6379

# Redis password (empty if none)
REDIS_PASSWORD=

# Redis database index to use
REDIS_DB=0

# Minimum idle Redis connections
REDIS_MIN_IDLE_CONNS=2

# Maximum Redis connections in pool
REDIS_POOL_SIZE=10

# Redis dial timeout in seconds
REDIS_DIAL_TIMEOUT=5

# Redis read timeout in seconds
REDIS_READ_TIMEOUT=3

# Redis write timeout in seconds
REDIS_WRITE_TIMEOUT=3

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# JWT secret key for signing tokens
# IMPORTANT: Generate a secure random value for production!
# Use: openssl rand -hex 64
JWT_SECRET=change-this-to-a-secure-random-value-in-production

# JWT expiration in hours
JWT_EXPIRATION_HOURS=24

# Refresh token expiration in hours
REFRESH_TOKEN_EXPIRATION_HOURS=168

# JWT cookie name
JWT_COOKIE_NAME=ping_jwt

# JWT cookie domain
JWT_COOKIE_DOMAIN=

# Enable secure cookies (true for HTTPS in production)
JWT_COOKIE_SECURE=false

# Enable HTTP-only cookies
JWT_COOKIE_HTTP_ONLY=true

# CORS allowed origins (comma-separated)
# Use "*" for development, restrict in production
CORS_ORIGINS=*

# ============================================================================
# MESSAGE CONFIGURATION
# ============================================================================

# Maximum message size in bytes (10 MB)
MAX_MESSAGE_SIZE=10485760

# Message retention days (how long to keep undelivered messages)
MESSAGE_RETENTION_DAYS=30

# Maximum number of attachments per message
MAX_ATTACHMENTS_PER_MESSAGE=10

# Maximum size of a single attachment in bytes (100 MB)
MAX_ATTACHMENT_SIZE=104857600

# ============================================================================
# RATE LIMIT CONFIGURATION
# ============================================================================

# Global rate limit in requests per second
RATE_LIMIT_RPS=100

# Auth endpoints rate limit in requests per second
RATE_LIMIT_AUTH_RPS=10

# Message endpoints rate limit in requests per second
RATE_LIMIT_MESSAGE_RPS=50

# Burst size (maximum number of requests that can be made at once)
RATE_LIMIT_BURST_SIZE=200

# ============================================================================
# OTP CONFIGURATION (MessageCentral for SMS OTP)
# ============================================================================

# Enable OTP authentication
OTP_ENABLED=true

# OTP provider (messagecentral, twilio, etc.)
OTP_PROVIDER=messagecentral

# MessageCentral API Key (from https://console.messagecentral.com/studio/home)
OTP_API_KEY=your-messagecentral-api-key

# MessageCentral API Secret
OTP_API_SECRET=your-messagecentral-api-secret

# Sender ID (alphanumeric or phone number)
OTP_SENDER_ID=PINGAPP

# OTP code length (default: 6)
OTP_LENGTH=6

# OTP expiration in minutes (default: 10)
OTP_EXPIRATION_MINUTES=10

# ============================================================================
# MEDIA STORAGE CONFIGURATION (Optional - not implemented yet)
# ============================================================================

# Cloudflare R2 or S3 endpoint
# MEDIA_STORAGE_ENDPOINT=

# Media storage access key
# MEDIA_STORAGE_ACCESS_KEY=

# Media storage secret key
# MEDIA_STORAGE_SECRET_KEY=

# Media storage bucket name
# MEDIA_STORAGE_BUCKET=ping-media

# Media storage region
# MEDIA_STORAGE_REGION=auto
